{
  "expo": {
    "name": "Tracker",
    "slug": "tracker",
    "description": "College attendance, timetable, and habit tracker with offline-first local storage and Supabase cloud sync.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tracker",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1115",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1115"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mohitverse.tracker",
      "backgroundColor": "#0F1115",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0F1115"
      }
    },
    "android": {
      "package": "com.mohitverse.tracker",
      "backgroundColor": "#0F1115",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0F1115"
      },
      "adaptiveIcon": {
        "backgroundColor": "#0F1115",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "androidStatusBar": {
      "backgroundColor": "#0F1115",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#0F1115",
      "barStyle": "light-content"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#58A6FF"
        }
      ],
      [
        "expo-document-picker",
        {
          "appleTeamId": "YOUR_TEAM_ID"
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "c5e08525-4a11-414a-a80b-2ffe531469ee"
      },
      "router": {},
      "supabaseUrl": "https://urejmenobovrcefozziw.supabase.co",
      "supabaseAnonKey": "sb_publishable_CXo9xg2UxxdYsslpgyUNFA_Dq-tfAHT"
    }
  }
}
